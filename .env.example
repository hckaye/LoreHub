# LoreHub application database (existing stack)
POSTGRES_PASSWORD=lorehub-development
POSTGRES_HOST_PORT=5432

# LoreHub API OIDC wiring. Leave LOREHUB_OIDC_ISSUER empty to keep the API's
# current bearer-only-disabled behavior. To enable Keycloak-backed auth, run
# scripts/setup-keycloak-secrets.sh and set the issuer to your Keycloak realm.
# Local default issuer: http://localhost:8280/realms/lorehub
LOREHUB_OIDC_ISSUER=
LOREHUB_OIDC_AUDIENCE=lorehub-api
LOREHUB_OIDC_CLIENT_ID=lorehub-web
LOREHUB_OIDC_PUBLIC_ORIGIN=http://localhost:3000
LOREHUB_LORE_IDENTITY=

# Keycloak realm name (must match infra/keycloak/realm-lorehub.json)
KEYCLOAK_REALM=lorehub

# Keycloak host port on the host machine. Default 8280 avoids collisions with
# the API (8080), web (3000), Lore (41337/41339), and Postgres (5432).
KEYCLOAK_HOST_PORT=8280

# Public hostname Keycloak advertises in tokens and OIDC discovery. Local
# default uses HTTP. In production set this to the public HTTPS URL that the
# reverse proxy serves, e.g. https://auth.lorehub.example
KEYCLOAK_HOSTNAME=http://localhost:8280

# Keycloak admin bootstrap user. The password is a secret: generate it with
# scripts/setup-keycloak-secrets.sh and never commit a real value here.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Dedicated Keycloak PostgreSQL database. Separate from the LoreHub database.
# Generate KEYCLOAK_DB_PASSWORD with scripts/setup-keycloak-secrets.sh.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=

# Confidential OIDC client secret for the LoreHub web client. Required for the
# Authorization Code + PKCE flow. Generate with scripts/setup-keycloak-secrets.sh.
LOREHUB_OIDC_CLIENT_SECRET=

# Social identity providers. Each provider is provisioned only when BOTH its
# client ID and client secret are set. Leave them empty to run without social
# login. Obtain credentials from each provider's developer console; see
# docs/operations/keycloak.md for callback URLs and console settings.

# Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
LOREHUB_IDP_GOOGLE_CLIENT_ID=
LOREHUB_IDP_GOOGLE_CLIENT_SECRET=
# Optional: restrict login to a Google Workspace domain (e.g. example.com)
LOREHUB_IDP_GOOGLE_HOSTED_DOMAIN=

# GitHub (GitHub > Settings > Developer settings > OAuth Apps)
LOREHUB_IDP_GITHUB_CLIENT_ID=
LOREHUB_IDP_GITHUB_CLIENT_SECRET=

# Facebook (Meta for Developers > Apps > Facebook Login)
LOREHUB_IDP_FACEBOOK_CLIENT_ID=
LOREHUB_IDP_FACEBOOK_CLIENT_SECRET=

# X / formerly Twitter (X Developer Portal > App > OAuth 2.0)
LOREHUB_IDP_X_CLIENT_ID=
LOREHUB_IDP_X_CLIENT_SECRET=
