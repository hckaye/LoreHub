# LoreHub application database (existing stack). Generate this value with
# scripts/setup-keycloak-secrets.sh; do not commit a database password.
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

# LoreHub API authentication. The default Compose stack uses interactive OIDC
# login through Keycloak. Set LOREHUB_AUTH_MODE=disabled explicitly to keep the
# API's authentication-disabled behavior, or use bearer for existing clients.
LOREHUB_ENV=development
LOREHUB_AUTH_MODE=interactive
LOREHUB_OIDC_ISSUER=http://keycloak.localhost:8280/realms/lorehub
LOREHUB_OIDC_AUDIENCE=lorehub-api
LOREHUB_OIDC_CLIENT_ID=lorehub-web
LOREHUB_OIDC_CLIENT_SECRET=
LOREHUB_OIDC_REDIRECT_URL=http://localhost:3000/auth/callback
LOREHUB_OIDC_LOGOUT_REDIRECT_URL=http://localhost:3000/
LOREHUB_PUBLIC_ORIGIN=http://localhost:3000
LOREHUB_PUBLIC_API_URL=http://localhost:3000/api/v3
LOREHUB_PUBLIC_GRAPHQL_URL=http://localhost:3000/api/graphql
LOREHUB_ACTION_SOURCE_URL=https://github.com
LOREHUB_AUTH_SECRET=
# Prometheus metrics at /metrics require this bearer token. The setup script
# generates it. Requests to API and authentication routes are limited per client.
LOREHUB_METRICS_TOKEN=
LOREHUB_RATE_LIMIT_REQUESTS=600
LOREHUB_RATE_LIMIT_WINDOW=1m
# Trust X-Forwarded-For only from the exact reverse proxy networks listed here.
LOREHUB_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
LOREHUB_SESSION_COOKIE_NAME=lorehub_session
LOREHUB_LOGIN_BINDING_COOKIE_NAME=lorehub_login_binding
LOREHUB_SESSION_COOKIE_PATH=/
LOREHUB_SESSION_COOKIE_DOMAIN=
LOREHUB_SESSION_COOKIE_SECURE=false
LOREHUB_SESSION_TTL=720h
LOREHUB_LOGIN_TRANSACTION_TTL=10m
# Lore-native authentication. The API uses the exact ucs-auth:// URL below for
# UCS clients and signs short-lived resource-scoped JWTs. The stock 0.8.6
# advertisement uses the exact ucs-auth:// scheme; its client opens the gRPC
# connection over TLS. A host-side client must trust infra/.local-tls/lorehub-local-ca.crt.
LOREHUB_LORE_ROOT_DOMAIN=lorehub.localhost
LOREHUB_LORE_INTERNAL_DOMAIN=lorehub.internal
LOREHUB_LORE_AUTH_ISSUER=auth.lorehub.localhost
LOREHUB_LORE_AUTH_AUDIENCE=lorehub.localhost
LOREHUB_LORE_AUTH_ENVIRONMENT=development
LOREHUB_LORE_AUTH_IDP=keycloak
LOREHUB_LORE_AUTH_TOKEN_TTL=5m
LOREHUB_LORE_AUTH_SESSION_TTL=5m
LOREHUB_LORE_AUTHORITY=auth.lorehub.localhost:8443
LOREHUB_LORE_AUTH_JWKS_URL=http://lorehub.localhost:8080/.well-known/jwks.json
LOREHUB_LORE_AUTH_URL=ucs-auth://auth.lorehub.localhost:8443
LOREHUB_LORE_AUTH_LOGIN_URL=http://lorehub.localhost:8080/auth/lore/confirm
LOREHUB_LORE_PUBLIC_URL=lores://lorehub.localhost:41337
LOREHUB_LORE_INTERNAL_URL=lores://lore.lorehub.localhost:41337
LOREHUB_LORE_POLICY_ENDPOINT=https://lorehub.localhost:8444/internal/lore/policy
LOREHUB_LORE_OBSERVATION_ENDPOINT=https://lorehub.localhost:8444/internal/lore/observation
LOREHUB_LORE_INTERNAL_AUTH_JWKS_URL=http://api.lorehub.internal:8080/.well-known/jwks.json
LOREHUB_LORE_INTERNAL_AUTH_URL=https://api.lorehub.internal:8443
LOREHUB_LORE_INTERNAL_POLICY_ENDPOINT=https://api.lorehub.internal:8444/internal/lore/policy
LOREHUB_LORE_INTERNAL_OBSERVATION_ENDPOINT=https://api.lorehub.internal:8444/internal/lore/observation
LOREHUB_LORE_PUBLIC_READER_SUBJECT=00000000-0000-4000-8000-000000000001
LOREHUB_LORE_ACTIONS_RUNNER_SUBJECT=00000000-0000-4000-8000-000000000002
LOREHUB_OBSERVER_SERVICE_PRINCIPAL=00000000-0000-4000-8000-000000000003
LOREHUB_LORE_REPOSITORY_REGISTRATION_SUBJECT=00000000-0000-4000-8000-000000000004
LOREHUB_LORE_REPOSITORY_LIFECYCLE_SUBJECT=00000000-0000-4000-8000-000000000005
LOREHUB_LORE_AUTH_ADDRESS=:8443
LOREHUB_LORE_AUTH_TLS_CERT=/var/lib/lorehub/tls/server.crt
LOREHUB_LORE_AUTH_TLS_KEY=/var/lib/lorehub/tls/server.key
LOREHUB_AUTH_SIGNING_KEY_PATH=/var/lib/lorehub/keys/lore-auth.pem
LOREHUB_AUTH_SIGNING_KEY_KID=local-current
LOREHUB_AUTH_PREVIOUS_KEYS=

# Actions variables and secrets stay in PostgreSQL. Secret values are encrypted
# with AES-256-GCM. Generate a dedicated key with `openssl rand -base64 32` and
# rotate it by changing both values after re-encrypting stored secrets.
LOREHUB_ACTIONS_SECRET_KEY_ID=local-actions-v1
LOREHUB_ACTIONS_SECRET_KEY=
LOREHUB_ACTIONS_JOB_TOKEN_AUDIENCE=http://localhost:3000/api/v3

# Runner registration and long-lived credentials use a dedicated HMAC key.
LOREHUB_RUNNER_TOKEN_KEY_ID=local-runner-v1
LOREHUB_RUNNER_TOKEN_KEY=

# Repository webhook signing secrets are encrypted with this dedicated key.
LOREHUB_WEBHOOK_SECRET_KEY_ID=local-webhooks-v1
LOREHUB_WEBHOOK_SECRET_KEY=
LOREHUB_WEBHOOK_POLL_PERIOD=2s
LOREHUB_WEBHOOK_REQUEST_TIMEOUT=10s
LOREHUB_WEBHOOK_LEASE_DURATION=30s
LOREHUB_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Lore Server registration tokens and credentials use this dedicated HMAC key.
LOREHUB_LORES_TOKEN_KEY_ID=local-lores-v1
LOREHUB_LORES_TOKEN_KEY=
LOREHUB_LORE_ALLOW_PRIVATE_SERVERS=false

# Account notification email. Local Compose sends to Mailpit; production must
# use an SMTP server with starttls or tls.
LOREHUB_NOTIFICATION_EMAIL_ENABLED=true
LOREHUB_NOTIFICATION_EMAIL_POLL_PERIOD=2s
LOREHUB_NOTIFICATION_EMAIL_SEND_TIMEOUT=10s
LOREHUB_NOTIFICATION_EMAIL_LEASE_DURATION=30s
LOREHUB_NOTIFICATION_EMAIL_MAX_ATTEMPTS=8
LOREHUB_SMTP_HOST=mailpit
LOREHUB_SMTP_PORT=1025
LOREHUB_SMTP_USERNAME=
LOREHUB_SMTP_PASSWORD=
LOREHUB_SMTP_FROM_ADDRESS=notifications@lorehub.localhost
LOREHUB_SMTP_FROM_NAME=LoreHub
LOREHUB_SMTP_TLS_MODE=none
MAILPIT_HOST_PORT=8025

LOREHUB_REPOSITORY_DELETION_RETENTION=720h
LOREHUB_REPOSITORY_DELETION_POLL_PERIOD=30s
LOREHUB_REPOSITORY_DELETION_TIMEOUT=90s
LOREHUB_REPOSITORY_DELETION_LEASE_DURATION=2m

LOREHUB_POLICY_ADDRESS=:8444
LOREHUB_POLICY_TLS_CERT=/var/lib/lorehub/tls/server.crt
LOREHUB_POLICY_TLS_KEY=/var/lib/lorehub/tls/server.key
LOREHUB_POLICY_TLS_CLIENT_CA=/var/lib/lorehub/tls/ca.crt
LOREHUB_LORE_SERVER_CA_CERT=/var/lib/lorehub/tls/ca.crt
LOREHUB_LORE_SERVER_CA_KEY=/var/lib/lorehub/tls-ca/ca.key
LOREHUB_TLS_SERVER_NAMES=lorehub.localhost,auth.lorehub.localhost,lore.lorehub.localhost,api.lorehub.internal
LOREHUB_WEB_API_URL=http://lorehub.localhost:8080

# Compatibility identity is intentionally empty. It is accepted only with an
# explicitly enabled isolated local compatibility profile, never in production.
LOREHUB_LORE_IDENTITY=
LOREHUB_ALLOW_LEGACY_LORE_IDENTITY=false

# Development/test compatibility switches. Production rejects static Lore
# credentials and fails closed when its scoped issuers are unavailable.
LOREHUB_LORE_CREDENTIALS=
LOREHUB_LORE_ALLOW_DEVELOPMENT_FALLBACK=false
LOREHUB_DEV_ALLOW_LORE_IDENTITY_FALLBACK=false
LOREHUB_DEV_LORE_IDENTITY=
LOREHUB_DEV_ALLOW_ACTIONS_CONTEXT_FALLBACK=false
LOREHUB_DEV_ACTIONS_CONTEXT_JSON=
LOREHUB_DEV_ALLOW_ACTIONS_JOB_TOKEN_FALLBACK=false
LOREHUB_DEV_ACTIONS_JOB_TOKEN=

# Actions runner settings. The control-plane principal is the dedicated
# LOREHUB_LORE_ACTIONS_RUNNER_SUBJECT UUID above.
LOREHUB_RUNNER_LOG_MAX_LINE_BYTES=1048576
# Optional JSON object overlay. ubuntu-latest defaults to the pinned act image.
LOREHUB_RUNNER_PLATFORM_IMAGES=

# Keycloak realm name (must match infra/keycloak/realm-lorehub.json)
KEYCLOAK_REALM=lorehub

# Keycloak host port on the host machine. Default 8280 avoids collisions with
# the API (8080), web (3000), Lore (41337/41339), and Postgres (5432).
KEYCLOAK_HOST_PORT=8280

# Public hostname Keycloak advertises in tokens and OIDC discovery. The local
# hostname resolves to the host from browsers and from the API container. In
# production set this to the public HTTPS URL served by the reverse proxy.
KEYCLOAK_HOSTNAME=http://keycloak.localhost:8280

# Keycloak admin bootstrap user. The password is a secret: generate it with
# scripts/setup-keycloak-secrets.sh and never commit a real value here.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Dedicated Keycloak PostgreSQL database. Separate from the LoreHub database.
# Generate KEYCLOAK_DB_PASSWORD with scripts/setup-keycloak-secrets.sh.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=

# Email verification is disabled locally so registration and login do not need
# an SMTP server. Production must set this to true and configure SMTP below.
LOREHUB_VERIFY_EMAIL=false

# Production SMTP settings. They are unused while LOREHUB_VERIFY_EMAIL=false.
# The bootstrap script validates the complete set before enabling verification.
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=LoreHub
KEYCLOAK_SMTP_REPLY_TO=
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME=LoreHub
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false

# Social identity providers. Each provider is provisioned only when BOTH its
# client ID and client secret are set. Leave them empty to run without social
# login. Obtain credentials from each provider's developer console; see
# docs/operations/keycloak.md for callback URLs and console settings.

# Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
LOREHUB_IDP_GOOGLE_CLIENT_ID=
LOREHUB_IDP_GOOGLE_CLIENT_SECRET=
# Optional: restrict login to a Google Workspace domain (e.g. example.com)
LOREHUB_IDP_GOOGLE_HOSTED_DOMAIN=

# GitHub (GitHub > Settings > Developer settings > OAuth Apps)
LOREHUB_IDP_GITHUB_CLIENT_ID=
LOREHUB_IDP_GITHUB_CLIENT_SECRET=

# Facebook (Meta for Developers > Apps > Facebook Login)
LOREHUB_IDP_FACEBOOK_CLIENT_ID=
LOREHUB_IDP_FACEBOOK_CLIENT_SECRET=

# X / formerly Twitter (X Developer Portal > App > OAuth 2.0)
LOREHUB_IDP_X_CLIENT_ID=
LOREHUB_IDP_X_CLIENT_SECRET=
