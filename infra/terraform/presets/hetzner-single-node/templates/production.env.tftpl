LOREHUB_ENV=production
LOREHUB_AUTH_MODE=interactive

LOREHUB_LORE_ROOT_DOMAIN=${root_domain}
LOREHUB_LORE_INTERNAL_DOMAIN=${internal_domain}
LOREHUB_TLS_SERVER_NAMES=${tls_server_names}
LOREHUB_TLS_SOURCE_DIR=${tls_source_dir}

LOREHUB_PUBLIC_ORIGIN=${public_origin_url}
LOREHUB_PUBLIC_API_URL=${public_api_url}
LOREHUB_PUBLIC_GRAPHQL_URL=${public_graphql_url}
LOREHUB_WEB_API_URL=http://api:8080

LOREHUB_OIDC_ISSUER=${oidc_issuer}
LOREHUB_OIDC_AUDIENCE=lorehub-api
LOREHUB_OIDC_CLIENT_ID=lorehub-web
LOREHUB_OIDC_REDIRECT_URL=${public_origin_url}/auth/callback
LOREHUB_OIDC_LOGOUT_REDIRECT_URL=${public_origin_url}/
KEYCLOAK_HOSTNAME=${keycloak_url}
LOREHUB_SESSION_COOKIE_SECURE=true
LOREHUB_ACTIONS_JOB_TOKEN_AUDIENCE=${public_api_url}

LOREHUB_LORE_AUTH_ISSUER=auth.${root_domain}
LOREHUB_LORE_AUTH_AUDIENCE=${root_domain}
LOREHUB_LORE_AUTH_ENVIRONMENT=production
LOREHUB_LORE_AUTH_IDP=keycloak
LOREHUB_LORE_AUTHORITY=auth.${root_domain}:8443
LOREHUB_LORE_AUTH_JWKS_URL=${public_origin_url}/.well-known/jwks.json
LOREHUB_LORE_AUTH_URL=ucs-auth://auth.${root_domain}:8443
LOREHUB_LORE_AUTH_LOGIN_URL=${public_origin_url}/auth/lore/confirm
LOREHUB_LORE_PUBLIC_URL=lores://${root_domain}:41337
LOREHUB_LORE_INTERNAL_URL=lores://lore.${root_domain}:41337
LOREHUB_LORE_POLICY_ENDPOINT=https://${root_domain}:8444/internal/lore/policy
LOREHUB_LORE_OBSERVATION_ENDPOINT=https://${root_domain}:8444/internal/lore/observation
LOREHUB_LORE_INTERNAL_AUTH_JWKS_URL=https://api.${internal_domain}:8443/.well-known/jwks.json
LOREHUB_LORE_INTERNAL_AUTH_URL=https://api.${internal_domain}:8443
LOREHUB_LORE_INTERNAL_POLICY_ENDPOINT=https://api.${internal_domain}:8444/internal/lore/policy
LOREHUB_LORE_INTERNAL_OBSERVATION_ENDPOINT=https://api.${internal_domain}:8444/internal/lore/observation

LOREHUB_HOSTED_LORE_SERVER_ENABLED=true
LOREHUB_INSTANCE_ADMIN_ENABLED=true
LOREHUB_INSTANCE_ADMIN_USERNAMES=${instance_admin_usernames}
LOREHUB_DEFAULT_ORGANIZATION_ENTITLEMENTS=hosted_lore_server,hosted_runners
LOREHUB_MAX_ORGANIZATIONS_PER_USER=${max_organizations_per_user}
LOREHUB_MAX_REPOSITORIES_PER_ORGANIZATION=${max_repositories_per_organization}
LOREHUB_MAX_REPOSITORY_SIZE_BYTES=${max_repository_size_bytes}

# Keycloak production bootstrap requires a verified-email SMTP configuration.
LOREHUB_VERIFY_EMAIL=true
KEYCLOAK_SMTP_HOST=${keycloak_smtp_host}
KEYCLOAK_SMTP_PORT=${keycloak_smtp_port}
KEYCLOAK_SMTP_FROM=${keycloak_smtp_from}
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=${keycloak_smtp_from_display_name}
KEYCLOAK_SMTP_REPLY_TO=${keycloak_smtp_reply_to}
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME=${keycloak_smtp_reply_to_display_name}
KEYCLOAK_SMTP_AUTH=${keycloak_smtp_auth}
KEYCLOAK_SMTP_USER=${keycloak_smtp_username}
KEYCLOAK_SMTP_PASSWORD=${keycloak_smtp_password}
KEYCLOAK_SMTP_STARTTLS=${keycloak_smtp_starttls}
KEYCLOAK_SMTP_SSL=${keycloak_smtp_ssl}

# Application notifications stay disabled until a separate application SMTP
# configuration is supplied through the repository's normal environment file.
LOREHUB_NOTIFICATION_EMAIL_ENABLED=false
