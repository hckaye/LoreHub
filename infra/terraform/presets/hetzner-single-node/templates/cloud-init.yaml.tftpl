#cloud-config
write_files:
  - path: /usr/local/lib/lorehub-node.sh
    owner: root:root
    permissions: "0644"
    content: |
      ${replace(lorehub_lib, "\n", "\n      ")}
  - path: /usr/local/sbin/lorehub-node-bootstrap
    owner: root:root
    permissions: "0750"
    content: |
      ${replace(bootstrap_script, "\n", "\n      ")}
  - path: /usr/local/sbin/lorehub-redeploy
    owner: root:root
    permissions: "0750"
    content: |
      ${replace(redeploy_script, "\n", "\n      ")}
  - path: /etc/lorehub-compose.hetzner.yaml
    owner: root:root
    permissions: "0644"
    content: |
      ${replace(compose_override, "\n", "\n      ")}
  - path: /etc/lorehub-production.env
    owner: root:root
    permissions: "0600"
    content: |
      ${replace(production_env, "\n", "\n      ")}
  - path: /etc/lorehub-nginx.conf
    owner: root:root
    permissions: "0644"
    content: |
      ${replace(nginx_config, "\n", "\n      ")}
  - path: /etc/systemd/system/lorehub.service
    owner: root:root
    permissions: "0644"
    content: |
      ${replace(lorehub_service, "\n", "\n      ")}
  - path: /etc/systemd/system/cloudflared.service
    owner: root:root
    permissions: "0644"
    content: |
      ${replace(cloudflared_service, "\n", "\n      ")}

runcmd:
  - [bash, /usr/local/sbin/lorehub-node-bootstrap]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, lorehub.service]
