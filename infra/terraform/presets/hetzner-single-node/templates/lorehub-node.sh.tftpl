# Shared helpers for lorehub-node-bootstrap and lorehub-redeploy.
# Sourced, not executed.

readonly APP_DIR=/opt/lorehub
readonly ENV_FILE=$${APP_DIR}/.env
readonly ENV_OVERRIDES=/etc/lorehub-production.env
readonly COMPOSE_OVERRIDE=/etc/lorehub-compose.hetzner.yaml
readonly REPOSITORY_URL=${repository_url}
readonly REPOSITORY_REF=${repository_ref}

: "$${LOREHUB_LOG_PREFIX:=lorehub}"

log() {
  printf '[%s] %s\n' "$$LOREHUB_LOG_PREFIX" "$$*"
}

fail() {
  printf '[%s] ERROR: %s\n' "$$LOREHUB_LOG_PREFIX" "$$*" >&2
  exit 1
}

update_env_key() {
  local key=$1
  local value=$2
  local temporary
  temporary=$(mktemp "$${ENV_FILE}.tmp.XXXXXX")
  awk -v key="$key" -v value="$value" '
    index($0, key "=") == 1 { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$ENV_FILE" >"$temporary"
  chmod 0600 "$temporary"
  mv "$temporary" "$ENV_FILE"
}

apply_env_overrides() {
  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "" | \#*) continue ;;
    esac
    key=$${line%%=*}
    value=$${line#*=}
    [[ -n "$key" ]] || fail "empty key in $ENV_OVERRIDES"
    update_env_key "$key" "$value"
  done <"$ENV_OVERRIDES"
}

prepare_environment() {
  [[ -s "$APP_DIR/.env.example" ]] || fail "$APP_DIR/.env.example is missing"
  if [[ ! -e "$ENV_FILE" ]]; then
    install -m 0600 "$APP_DIR/.env.example" "$ENV_FILE"
  fi
  "$APP_DIR/scripts/setup-keycloak-secrets.sh" --env-file "$ENV_FILE"
  apply_env_overrides
  install -m 0644 "$COMPOSE_OVERRIDE" "$APP_DIR/compose.hetzner.yaml"
}

clone_repository() {
  if [[ ! -e "$APP_DIR" ]]; then
    install -d -m 0755 "$(dirname "$APP_DIR")"
    log "Cloning LoreHub at $REPOSITORY_REF"
    git clone --depth 1 --single-branch --branch "$REPOSITORY_REF" \
      "$REPOSITORY_URL" "$APP_DIR"
  elif [[ ! -d "$APP_DIR/.git" ]]; then
    fail "$APP_DIR exists but is not a Git checkout"
  fi
}

checkout_repository() {
  local ref=$1
  [[ -d "$APP_DIR/.git" ]] || fail "$APP_DIR is not a Git checkout"
  log "Fetching LoreHub $ref"
  git -C "$APP_DIR" fetch --depth 1 --force origin "$ref"
  git -C "$APP_DIR" checkout --force --detach FETCH_HEAD
}
