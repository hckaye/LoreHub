[Unit]
Description=LoreHub Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/lorehub/lore-data

[Service]
Type=oneshot
WorkingDirectory=/opt/lorehub
ExecStartPre=/usr/local/sbin/lorehub-node-bootstrap
ExecStart=/usr/bin/docker compose --env-file .env -f infra/compose.yaml -f compose.hetzner.yaml up --detach --build
ExecStop=-/usr/bin/docker compose --env-file .env -f infra/compose.yaml -f compose.hetzner.yaml down
RemainAfterExit=yes
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
