diff --git a/lore-server/src/protocol/storage/quota.rs b/lore-server/src/protocol/storage/quota.rs
new file mode 100644
index 0000000000000000000000000000000000000000..eb902f53a4a29cf57a2106c82c719f3a55f1444b
--- /dev/null
+++ b/lore-server/src/protocol/storage/quota.rs
@@ -0,0 +1,178 @@
+// SPDX-FileCopyrightText: 2026 Epic Games, Inc.
+// SPDX-License-Identifier: MIT
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use dashmap::DashMap;
+use lore_revision::lore::RepositoryId;
+use tokio::sync::watch;
+use tokio::task::JoinHandle;
+use tracing::warn;
+
+/// Process-wide per-repository accounting for client-uploaded immutable bytes.
+pub struct RepoQuota {
+    used: DashMap<RepositoryId, AtomicU64>,
+    limit: u64,
+    state_path: PathBuf,
+    persist_lock: Mutex<()>,
+}
+
+impl RepoQuota {
+    pub fn new(limit: u64, state_path: impl Into<PathBuf>) -> Self {
+        let quota = Self {
+            used: DashMap::new(),
+            limit,
+            state_path: state_path.into(),
+            persist_lock: Mutex::new(()),
+        };
+        quota.load();
+        quota
+    }
+
+    /// Atomically reserve bytes if the repository remains within its limit.
+    pub fn try_charge(&self, repository: RepositoryId, bytes: u64) -> bool {
+        let entry = self
+            .used
+            .entry(repository)
+            .or_insert_with(|| AtomicU64::new(0));
+        let mut current = entry.load(Ordering::Acquire);
+
+        loop {
+            let Some(next) = current.checked_add(bytes) else {
+                return false;
+            };
+            if next > self.limit {
+                return false;
+            }
+            match entry.compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire) {
+                Ok(_) => return true,
+                Err(observed) => current = observed,
+            }
+        }
+    }
+
+    /// Return a reservation when the store write that followed it failed.
+    pub fn refund(&self, repository: RepositoryId, bytes: u64) {
+        let Some(entry) = self.used.get(&repository) else {
+            return;
+        };
+        let mut current = entry.load(Ordering::Acquire);
+
+        loop {
+            let next = current.saturating_sub(bytes);
+            match entry.compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire) {
+                Ok(_) => return,
+                Err(observed) => current = observed,
+            }
+        }
+    }
+
+    /// Restore previously persisted per-repository usage, if the state file exists.
+    pub fn load(&self) {
+        let contents = match fs::read(&self.state_path) {
+            Ok(contents) => contents,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return,
+            Err(error) => {
+                warn!(
+                    path = %self.state_path.display(),
+                    error = ?error,
+                    "Could not load upload quota state"
+                );
+                return;
+            }
+        };
+
+        let state: BTreeMap<String, u64> = match serde_json::from_slice(&contents) {
+            Ok(state) => state,
+            Err(error) => {
+                warn!(
+                    path = %self.state_path.display(),
+                    error = ?error,
+                    "Could not parse upload quota state"
+                );
+                return;
+            }
+        };
+
+        for (repository, bytes) in state {
+            match repository.parse() {
+                Ok(repository) => {
+                    self.used.insert(repository, AtomicU64::new(bytes));
+                }
+                Err(error) => warn!(
+                    repository,
+                    error = ?error,
+                    "Ignoring invalid repository in upload quota state"
+                ),
+            }
+        }
+    }
+
+    /// Persist a snapshot of the current usage. Errors are returned to the caller so periodic
+    /// and shutdown callers can log them without making quota enforcement fail open or closed.
+    pub fn persist(&self) -> io::Result<()> {
+        let _guard = self
+            .persist_lock
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        let state = self
+            .used
+            .iter()
+            .map(|entry| {
+                (
+                    entry.key().to_string(),
+                    entry.value().load(Ordering::Acquire),
+                )
+            })
+            .collect::<BTreeMap<_, _>>();
+        let contents = serde_json::to_vec_pretty(&state).map_err(io::Error::other)?;
+
+        if let Some(parent) = self.state_path.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        fs::write(&self.state_path, contents)
+    }
+
+    pub fn spawn_flush_task(
+        quota: Arc<Self>,
+        mut shutdown_rx: watch::Receiver<bool>,
+        flush_seconds: u64,
+    ) -> JoinHandle<()> {
+        let interval_duration = Duration::from_secs(flush_seconds.max(1));
+        tokio::spawn(async move {
+            let mut interval = tokio::time::interval(interval_duration);
+            loop {
+                tokio::select! {
+                    _ = interval.tick() => {
+                        if let Err(error) = quota.persist() {
+                            warn!(
+                                path = %quota.state_path.display(),
+                                error = ?error,
+                                "Could not persist upload quota state"
+                            );
+                        }
+                    }
+                    changed = shutdown_rx.changed() => {
+                        if changed.is_err() || *shutdown_rx.borrow() {
+                            if let Err(error) = quota.persist() {
+                                warn!(
+                                    path = %quota.state_path.display(),
+                                    error = ?error,
+                                    "Could not persist upload quota state during shutdown"
+                                );
+                            }
+                            break;
+                        }
+                    }
+                }
+            }
+        })
+    }
+}
